<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- <TreatWarningsAsErrors>true</TreatWarningsAsErrors> -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <Version>1.0.0</Version>
    <Authors>Robert H. Engelhardt</Authors>
    <Company>TBD</Company>
    <Copyright>TBD</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/rheone/Mediance</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/rheone/Mediance</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageTags>mediator;cqrs;pipeline;result;union</PackageTags>
  </PropertyGroup>

  <!-- Source Link -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- Suppress documentation warnings (CS1591) and StyleCop doc warnings (SA1600) -->
  <!-- XML doc files are still generated, just warnings are suppressed -->
  <PropertyGroup>
    <!-- <NoWarn>$(NoWarn);CS1591;SA1600;SA1101;SA1633;SA1313;SA1106;SA1127;SA1202;SA1503;SA1000;SA1009;SA1010;SA1122;AD0001</NoWarn> -->
  </PropertyGroup>

  <!-- Shared BCL usings -->
  <ItemGroup>
    <Using Include="System.Collections.Concurrent" />
  </ItemGroup>

  <!-- Roslynator analyzers -->
  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Roslynator.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Formatting.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- StyleCop -->
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Shared AdditionalFiles -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory).editorconfig" Link=".editorconfig" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)dictionary.dic" Link="dictionary.dic" />
  </ItemGroup>
</Project>
