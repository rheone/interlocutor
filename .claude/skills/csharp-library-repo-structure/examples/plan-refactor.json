{
  "$note": "Sample refactor plan for an existing repo. Generated by mapping scan_repo.py findings to apply_plan.py actions. Illustrative only.",
  "actions": [
    {
      "action": "gitignore_add",
      "pattern": "TestResults/",
      "reason": "Test output leaking into repo"
    },
    {
      "action": "gitignore_add",
      "pattern": "*.nupkg",
      "reason": "NuGet packages committed accidentally"
    },
    {
      "action": "git_rm_cached",
      "path": "TestResults/some-file.trx",
      "reason": "Untrack committed test results"
    },
    {
      "action": "git_rm_cached",
      "path": "bin/",
      "reason": "Untrack committed build output"
    },
    {
      "action": "git_mv",
      "from": "MyLib.Tests",
      "to": "src/MyLib.Tests",
      "reason": "Move test project under src/"
    },
    {
      "action": "create_from_template",
      "template": "CONTRIBUTING.md.tmpl",
      "dest": "CONTRIBUTING.md",
      "skip_if_exists": true,
      "reason": "Missing contributing guide"
    },
    {
      "action": "create_from_template",
      "template": "SECURITY.md.tmpl",
      "dest": "SECURITY.md",
      "skip_if_exists": true,
      "reason": "Missing security policy"
    },
    {
      "action": "create_from_template",
      "template": "CHANGELOG.md.tmpl",
      "dest": "CHANGELOG.md",
      "skip_if_exists": true,
      "reason": "Missing changelog"
    },
    {
      "action": "create_from_template",
      "template": "CODE_OF_CONDUCT.md.tmpl",
      "dest": "CODE_OF_CONDUCT.md",
      "skip_if_exists": true,
      "reason": "Missing code of conduct"
    }
  ]
}
