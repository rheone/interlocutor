name: build

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build-test:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: src
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-dotnet@v4
        with:
          global-json-file: global.json

      - name: Restore
        run: dotnet restore --locked-mode

      - name: Build
        run: dotnet build --no-restore -c Release

      - name: Test
        run: dotnet test --no-build -c Release --logger trx --results-directory TestResults

      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-results
          path: src/TestResults

  smoke-test:
    runs-on: ubuntu-latest
    needs: build-test
    if: ${{ hashFiles('smoketests/**') != '' }}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-dotnet@v4
        with:
          global-json-file: global.json

      - name: Pack
        working-directory: src
        run: dotnet pack -c Release -o ../smoketests/{{LibraryName}}.SmokeTests/feed

      - name: Run smoke tests
        working-directory: smoketests/{{LibraryName}}.SmokeTests
        run: bash run-smoke-tests.sh
