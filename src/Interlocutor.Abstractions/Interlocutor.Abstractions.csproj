<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Interlocutor mediator abstractions: IMediator, IPipelineBehavior, handler contracts, marker interfaces, and the concrete Mediator implementation.</Description>
    <!-- Trim-compatible, deliberately NOT IsAotCompatible: OperationOutcome<...> is a value type, so the
         container cannot close IPipelineBehavior<TRequest,TResponse> over it without a JIT. Tracked at
         .scratch/aot-support/map.md; see maintainer_docs/research/native-aot-and-trimming-options.md for the evidence. -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interlocutor.CommonKernel\Interlocutor.CommonKernel.csproj" />
  </ItemGroup>

  <!-- DependencyInjection.Abstractions and Logging.Abstractions are auto-available in .NET 11 SDK -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
