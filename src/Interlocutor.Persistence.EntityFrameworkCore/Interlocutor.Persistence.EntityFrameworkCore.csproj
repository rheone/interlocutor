<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>EF Core implementation of Interlocutor's optional persistence abstraction. Provides IUnitOfWork and IDomainRepository backed by DbContext.</Description>
    <!-- Trim-compatible, deliberately NOT IsAotCompatible: OperationOutcome<...> is a value type, so the
         container cannot close IPipelineBehavior<TRequest,TResponse> over it without a JIT. Tracked at
         .scratch/aot-support/map.md; see maintainer_docs/research/native-aot-and-trimming-options.md for the evidence. -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interlocutor.Persistence.Abstractions\Interlocutor.Persistence.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- UnitOfWorkSaveChangesInterceptor.IsSuppressed is internal - an implementation detail shared with
         UnitOfWorkBehavior, not part of this package's public API - but UnitOfWorkSaveChangesInterceptorTests
         exercises the suppression flag directly, in isolation from the behavior that sets it. -->
    <InternalsVisibleTo Include="Interlocutor.Persistence.EntityFrameworkCore.Tests" />
  </ItemGroup>
</Project>
