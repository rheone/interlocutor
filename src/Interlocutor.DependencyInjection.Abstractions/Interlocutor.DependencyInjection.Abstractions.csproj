<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Container-neutral dependency-injection registration abstractions for Interlocutor. Owns the neutral registration record that the Microsoft DI and Autofac packages translate into their own primitives.</Description>
    <!-- Trim-compatible, deliberately NOT IsAotCompatible: OperationOutcome<...> is a value type, so the
         container cannot close IPipelineBehavior<TRequest,TResponse> over it without a JIT. Tracked at
         .scratch/aot-support/map.md; see maintainer_docs/research/native-aot-and-trimming-options.md for the evidence. -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interlocutor.Abstractions\Interlocutor.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AssemblyTypeScanner.ExtractLoadedTypes is internal - genuinely an implementation detail, not part of
         this package's public builder API - but its ReflectionTypeLoadException handling needs to be
         exercised directly against a manually-constructed exception rather than requiring a genuinely
         unloadable assembly on disk. -->
    <InternalsVisibleTo Include="Interlocutor.DependencyInjection.Abstractions.Tests" />
  </ItemGroup>
</Project>
