<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Autofac integration for Interlocutor. Registers the mediator, handlers, and pipeline behaviors via AddInterlocutor().</Description>
    <!-- Trim-compatible, deliberately NOT IsAotCompatible: OperationOutcome<...> is a value type, so the
         container cannot close IPipelineBehavior<TRequest,TResponse> over it without a JIT. Tracked at
         .scratch/aot-support/map.md; see docs/research/native-aot-and-trimming-options.md for the evidence. -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interlocutor.Abstractions\Interlocutor.Abstractions.csproj" />
    <ProjectReference Include="..\Interlocutor.DependencyInjection.Abstractions\Interlocutor.DependencyInjection.Abstractions.csproj" />
    <!-- Persistence.Abstractions only - zero ORM dependency, so opting an Autofac consumer into
         AddInterlocutor() never pulls in EF Core or NHibernate transitively. The concrete IUnitOfWork/
         IDomainRepository implementation is supplied by the consumer's own factory delegate at the call
         site - see PersistenceContainerBuilderExtensions. -->
    <ProjectReference Include="..\Interlocutor.Persistence.Abstractions\Interlocutor.Persistence.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
