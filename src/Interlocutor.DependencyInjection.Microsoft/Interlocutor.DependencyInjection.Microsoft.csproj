<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Microsoft.Extensions.DependencyInjection integration for Interlocutor. Registers the mediator, handlers, and pipeline behaviors via AddInterlocutor().</Description>
    <!-- Trim-compatible, deliberately NOT IsAotCompatible: OperationOutcome<...> is a value type, so the
         container cannot close IPipelineBehavior<TRequest,TResponse> over it without a JIT. Tracked at
         .scratch/aot-support/map.md; see docs/research/native-aot-and-trimming-options.md for the evidence. -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interlocutor.Abstractions\Interlocutor.Abstractions.csproj" />
    <ProjectReference Include="..\Interlocutor.DependencyInjection.Abstractions\Interlocutor.DependencyInjection.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
</Project>
