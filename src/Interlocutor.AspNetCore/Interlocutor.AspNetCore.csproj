<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>ASP.NET Core integration for Interlocutor. Provides ToActionResult() mapping from Outcome/Failure to HTTP ProblemDetails responses.</Description>
    <!-- Trim-compatible, deliberately NOT IsAotCompatible: Outcome<...> is a value type, so the
         container cannot close IPipelineBehavior<TRequest,TResponse> over it without a JIT. Tracked at
         .scratch/aot-support/map.md; see maintainer_docs/research/native-aot-and-trimming-options.md for the evidence. -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interlocutor.CommonKernel\Interlocutor.CommonKernel.csproj" />
    <ProjectReference Include="..\Interlocutor.Abstractions\Interlocutor.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Analyzer-only reference: ResultExtensionsGenerator must run over this project's own compilation, since
       ResultExtensions's generated per-arity ToActionResult/ToMinimalApiResult overloads have to exist in the
       shipped Interlocutor.AspNetCore.dll itself, not merely in some downstream consumer that happens to
       reference the generator. ReferenceOutputAssembly="false" means this adds no actual assembly dependency -
       mirrors Interlocutor.CommonKernel's own reference for its self-generated Outcome members. -->
  <ItemGroup>
    <ProjectReference
      Include="..\Interlocutor.Generator\Interlocutor.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <!-- Public API surface tracking: fails the build if a public member changes without
       being recorded in PublicAPI.Shipped.txt/PublicAPI.Unshipped.txt. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
