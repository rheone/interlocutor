#!/bin/sh
# Enforce UTF-8 without BOM (byte order mark) in tracked text files.
# Automatically strips UTF-8 BOM (EF BB BF) from staged files.

git diff --cached --name-only --diff-filter=ACM | while IFS= read -r file; do
    if [ -f "$file" ]; then
        first=$(head -c 3 "$file" | od -An -tx1 | tr -d ' \n')
        if [ "$first" = "efbbbf" ]; then
            tail -c +4 "$file" > "${file}.bomfix" && mv "${file}.bomfix" "$file"
            git add "$file"
            echo "Fixed UTF-8 BOM in: $file"
        fi
    fi
done
