dotnet_diagnostic.IDE0055.severity = Suggestion # Fix formatting
dotnet_diagnostic.IDE0079.severity = Warning    # Remove unnecessary suppression
dotnet_diagnostic.IDE1006.severity = None       # Naming rule violation

# AnalyzerId= Microsoft.CodeAnalysis.CSharp.Features  RuleNamespace= Microsoft.CodeAnalysis.CSharp.Features
# Also built into the Roslyn compiler/SDK - the IDE "quick actions"/refactoring-backed style rules.
dotnet_diagnostic.IDE0003.severity = None    # Remove unnecessary 'this.' qualification
dotnet_diagnostic.IDE0007.severity = Warning # Use 'var' instead of an explicit type
dotnet_diagnostic.IDE0009.severity = Warning # Add 'this.' qualification

# AnalyzerId= Microsoft.CodeAnalysis.PublicApiAnalyzers  RuleNamespace= Microsoft.CodeAnalysis.PublicApiAnalyzers
# Tracks each project's public API surface (RS00xx-prefixed) against a PublicAPI.Shipped.txt/
# PublicAPI.Unshipped.txt pair, failing the build if a public member changes without being
# recorded - guards against accidental breaking changes. Referenced only by the packable src/
# libraries (not Interlocutor.Generator, which tracks its own shipped diagnostics via
# AnalyzerReleases.*.md instead; not tests or TutorialProject, which ship nothing). Runs on
# defaults except RS0026 below.
# See <https://github.com/dotnet/roslyn/blob/main/src/RoslynAnalyzers/PublicApiAnalyzers/PublicApiAnalyzers.Help.md>
dotnet_diagnostic.RS0026.severity = None # "Do not add multiple overloads with optional parameters" -
# this library's core pattern is exactly that: ISender/IPublisher/Mediator/ResultExtensions
# deliberately expose several generic overloads (one per Outcome arity/shape) that all
# happen to carry the same optional CancellationToken parameter, disambiguated by the required
# parameter's constrained type, not by arity. RS0026 cannot tell that apart from a genuine
# ambiguous-overload mistake, so it fires on every one of them (see ISender.cs, IPublisher.cs).

# AnalyzerId= Roslynator.Analyzers / Roslynator.CodeAnalysis.Analyzers / Roslynator.Formatting.Analyzers
# General-purpose C# code-quality, simplification, and formatting analyzer suite (RCS-prefixed),
# referenced solution-wide. Runs on its shipped default severities everywhere except RCS1192,
# overridden further below (scoped to test files).

# AnalyzerId= Microsoft.VisualStudio.Threading.Analyzers  RuleNamespace= Microsoft.VisualStudio.Threading.Analyzers
# Threading/async best-practice analyzer (VSTHRD-prefixed): deadlock-prone sync-over-async,
# missing ConfigureAwait, async-void, and async-naming conventions.
dotnet_diagnostic.VSTHRD002.severity = Warning    # Synchronously waiting on a Task (.Result, .Wait(), .GetAwaiter().GetResult()) risks a deadlock
dotnet_diagnostic.VSTHRD003.severity = Warning    # Avoid awaiting a "foreign" Task created outside the current method's control
dotnet_diagnostic.VSTHRD100.severity = Warning    # Avoid async void methods - use async Task so exceptions and completion can be observed
dotnet_diagnostic.VSTHRD103.severity = Warning    # Call the async version of a method when already inside an async method
dotnet_diagnostic.VSTHRD105.severity = Suggestion # Avoid async method overloads that implicitly capture TaskScheduler.Current
dotnet_diagnostic.VSTHRD110.severity = Warning    # Observe the result of an async call instead of discarding it (accidental fire-and-forget)
dotnet_diagnostic.VSTHRD111.severity = Warning    # Use ConfigureAwait(bool) on the awaited expression
dotnet_diagnostic.VSTHRD112.severity = Suggestion # Implement System.IAsyncDisposable alongside IDisposable when cleanup can be asynchronous
dotnet_diagnostic.VSTHRD113.severity = Suggestion # Check for System.IAsyncDisposable in addition to IDisposable when disposing an object
dotnet_diagnostic.VSTHRD114.severity = Warning    # Avoid returning null from a Task-returning method - awaiting null throws NullReferenceException
# VSTHRD200 ("Async" suffix) is intentionally off solution-wide: the mediator's public dispatch
# contract (ICommandHandler/IQueryHandler/INotificationHandler.Handle, ISender.Send,
# IPublisher.Publish, IPipelineBehavior.Handle, IUnitOfWork.Cancel, ...) deliberately omits the
# suffix, following MediatR-style naming - it's the verb consumers call, not a framework-plumbing
# method. Every hit traces back to one of these members, an override of one, or a test double
# implementing/mocking one; renaming them would be a breaking change to this deliberate naming
# choice, not a bug fix. Internal extension-point hooks still carry the suffix where it adds clarity (e.g.
# ResourceCommandHandler's protected HandleAsync), so this is a naming choice, not a blind opt-out.
dotnet_diagnostic.VSTHRD200.severity = None       # Use an "Async" suffix for async methods

