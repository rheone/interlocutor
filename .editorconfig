# Naming styles
dotnet_naming_style.pascalcase.required_prefix =
dotnet_naming_style.pascalcase.required_suffix =
dotnet_naming_style.pascalcase.word_separator =
dotnet_naming_style.pascalcase.capitalization = pascal_case

dotnet_naming_style.ipascalcase.required_prefix = I
dotnet_naming_style.ipascalcase.required_suffix =
dotnet_naming_style.ipascalcase.word_separator =
dotnet_naming_style.ipascalcase.capitalization = pascal_case

dotnet_naming_style.tpascalcase.required_prefix = T
dotnet_naming_style.tpascalcase.required_suffix =
dotnet_naming_style.tpascalcase.word_separator =
dotnet_naming_style.tpascalcase.capitalization = pascal_case

dotnet_naming_style._camelcase.required_prefix = _
dotnet_naming_style._camelcase.required_suffix =
dotnet_naming_style._camelcase.word_separator =
dotnet_naming_style._camelcase.capitalization = camel_case

dotnet_naming_style.camelcase.required_prefix =
dotnet_naming_style.camelcase.required_suffix =
dotnet_naming_style.camelcase.word_separator =
dotnet_naming_style.camelcase.capitalization = camel_case

dotnet_naming_style.s_camelcase.required_prefix = s_
dotnet_naming_style.s_camelcase.required_suffix =
dotnet_naming_style.s_camelcase.word_separator =
dotnet_naming_style.s_camelcase.capitalization = camel_case
dotnet_style_namespace_match_folder = true:suggestion
dotnet_style_allow_multiple_blank_lines_experimental = true:suggestion
dotnet_style_allow_statement_immediately_after_block_experimental = true:silent

# AnalyzerId= AsyncFixer  RuleNamespace= AsyncFixer
# Detects async/await anti-patterns: unnecessary await, blocking calls inside async methods, and
# fire-and-forget mistakes. Referenced solution-wide (Directory.Build.props).
dotnet_diagnostic.AsyncFixer01.severity = Suggestion # Unnecessary async/await usage - the method could return the inner Task directly
dotnet_diagnostic.AsyncFixer02.severity = Warning    # Long-running or blocking synchronous call (e.g. Thread.Sleep, sync I/O) inside an async method
dotnet_diagnostic.AsyncFixer03.severity = Warning    # Fire-and-forget async void method
dotnet_diagnostic.AsyncFixer04.severity = Warning    # Fire-and-forget async call made inside a using block - the resource may be disposed before the task completes
dotnet_diagnostic.AsyncFixer05.severity = Suggestion # Downcasting from a Task to a Task<T>

# AnalyzerId= AsyncUsageAnalyzers  RuleNamespace= AsyncUsageAnalyzers
# Flags await expressions missing ConfigureAwait. NOT currently referenced by any project (no
# AsyncUsageAnalyzers PackageReference exists) - this entry is inert; Microsoft.VisualStudio.Threading.Analyzers'
# VSTHRD111 below covers the same concern and is actually live.
dotnet_diagnostic.UseConfigureAwait.severity = Warning # An await expression does not call ConfigureAwait

# AnalyzerId= DocumentationAnalyzers  RuleNamespace= DocumentationAnalyzers
# Flags malformed or inconsistent XML doc-comment markup. NOT currently referenced by any project
# (no DotNetAnalyzers.DocumentationAnalyzers PackageReference exists) - these entries are inert.
dotnet_diagnostic.DOC100.severity = Warning # Content in a <remarks> or <note> element should be wrapped in block-level elements
dotnet_diagnostic.DOC101.severity = Warning # Documentation mixes block-wrapped text and inline text inconsistently
dotnet_diagnostic.DOC102.severity = Warning # Documentation uses inline text where a sibling element of the same kind uses block-level elements
dotnet_diagnostic.DOC103.severity = Warning # Unnecessary or unrecognized HTML character entities should be replaced with Unicode characters
dotnet_diagnostic.DOC104.severity = Warning # A keyword wrapped in a <c> tag should use <see langword="..."/> instead
dotnet_diagnostic.DOC105.severity = Warning # A parameter reference wrapped in a <c> tag should use <paramref name="..."/> instead
dotnet_diagnostic.DOC106.severity = Warning # A type parameter reference wrapped in a <c> tag should use <typeparamref name="..."/> instead
dotnet_diagnostic.DOC107.severity = Warning # A code element reference wrapped in a <c> tag should use <see cref="..."/> instead
dotnet_diagnostic.DOC108.severity = Warning # An empty <para/> or <p/> element used as a separator should be removed
dotnet_diagnostic.DOC200.severity = Warning # Documentation uses an HTML element where an XML documentation element was expected (e.g. <p> instead of <para>)
dotnet_diagnostic.DOC201.severity = Warning # Content within an <item> element should be wrapped in a <description> element
dotnet_diagnostic.DOC202.severity = Warning # Documentation contains a section element where a block or inline element was expected
dotnet_diagnostic.DOC203.severity = Warning # Documentation contains a block element where a section or inline element was expected
dotnet_diagnostic.DOC204.severity = Warning # Documentation contains an inline element where a section or block element was expected

# AnalyzerId= IDisposableAnalyzers  RuleNamespace= IDisposableAnalyzers
# Flags IDisposable ownership/lifetime mistakes (IDISP-prefixed): created-but-undisposed instances,
# disposing an injected dependency you don't own, returning an already-disposed instance, etc.
# Referenced solution-wide. Runs on its shipped default severities everywhere except IDISP001 in
# test files (see the [tests/**/*.cs] section further below) - nothing else here currently
# warrants a stronger or weaker severity than IDisposableAnalyzers' own defaults.

# AnalyzerId= Microsoft.Analyzers.ManagedCodeAnalysis  RuleNamespace= Microsoft.Rules.Managed
# Legacy "Code Analysis" (pre-Roslyn FxCop) rule IDs carried over from this repo's original
# ruleset. The general design/usage/reliability rules below are still produced today by the .NET
# SDK's built-in analyzers (EnableNETAnalyzers, on by default for SDK-style projects); the
# CAS/security-transparency rules (CA2108, CA2111-CA2149), the COM/P-Invoke interop rules
# (CA1400-CA1415), the portability rules (CA1900-CA1901), and the WinForms mobility rule (CA1301)
# predate .NET Core - Code Access Security doesn't exist there - and are not produced by anything
# in this SDK. Kept for parity with the original ruleset, not confirmed-live enforcement.
dotnet_diagnostic.CA1001.severity = Warning # Types that own disposable fields should be disposable
dotnet_diagnostic.CA1009.severity = Warning # Declare event handlers correctly
dotnet_diagnostic.CA1016.severity = Warning # Mark assemblies with assembly version
dotnet_diagnostic.CA1033.severity = Warning # Interface methods should be callable by child types
dotnet_diagnostic.CA1049.severity = Warning # Types that own native resources should be disposable
dotnet_diagnostic.CA1056.severity = Warning # URI properties should not be strings
dotnet_diagnostic.CA1060.severity = Warning # Move P/Invokes to a dedicated NativeMethods class
dotnet_diagnostic.CA1061.severity = Warning # Do not hide base class methods
dotnet_diagnostic.CA1063.severity = Warning # Implement IDisposable correctly
dotnet_diagnostic.CA1065.severity = Warning # Do not raise exceptions in unexpected locations (e.g. property getters, Equals, finalizers)
dotnet_diagnostic.CA1301.severity = Warning # Avoid duplicate keyboard accelerators
dotnet_diagnostic.CA1400.severity = Warning # P/Invoke entry points should exist
dotnet_diagnostic.CA1401.severity = Warning # P/Invoke methods should not be visible
dotnet_diagnostic.CA1403.severity = Warning # Auto-layout types should not be COM-visible
dotnet_diagnostic.CA1404.severity = Warning # Call GetLastError immediately after a P/Invoke call
dotnet_diagnostic.CA1405.severity = Warning # A COM-visible type's base type should also be COM-visible
dotnet_diagnostic.CA1410.severity = Warning # COM registration and unregistration methods should be matched
dotnet_diagnostic.CA1415.severity = Warning # Declare P/Invoke members correctly
dotnet_diagnostic.CA1821.severity = Warning # Remove empty finalizers
dotnet_diagnostic.CA1825.severity = Warning # Avoid unnecessary zero-length array allocations; use Array.Empty<T>() instead
dotnet_diagnostic.CA1900.severity = Warning # Value type fields declared for P/Invoke should be portable across platforms
dotnet_diagnostic.CA1901.severity = Warning # P/Invoke declarations should be portable across platforms
dotnet_diagnostic.CA2000.severity = Warning # Dispose objects before losing scope
dotnet_diagnostic.CA2002.severity = Warning # Do not lock on objects with weak identity
dotnet_diagnostic.CA2100.severity = Warning # Review SQL queries for security vulnerabilities
dotnet_diagnostic.CA2101.severity = Warning # Specify marshaling for P/Invoke string arguments
dotnet_diagnostic.CA2108.severity = Warning # Review declarative security on value types
dotnet_diagnostic.CA2111.severity = Warning # Pointers should not be visible
dotnet_diagnostic.CA2112.severity = Warning # Secured types should not expose fields
