# AnalyzerId= SonarAnalyzer.CSharp  RuleNamespace= SonarAnalyzer.CSharp
# General bug/vulnerability/code-smell static analysis (S-prefixed), referenced solution-wide.
# Only the rules below are overridden from their shipped severity - the rest of the ruleset runs
# on SonarAnalyzer's prescribed defaults.
dotnet_diagnostic.S107.severity = Suggestion  #  Methods should not have too many parameters
dotnet_diagnostic.S1210.severity = Suggestion # "Equals" and the comparison operators should be overridden when implementing "IComparable"
dotnet_diagnostic.S2436.severity = Suggestion # Types and methods should not have too many generic parameters
dotnet_diagnostic.S4457.severity = Warning    # Parameter validation in "async"/"await" methods should be wrapped

# C# Autogenerated code
[{**/obj/**,**/bin/**}]
# AnalyzerId= Microsoft.CodeAnalysis.CSharp  RuleNamespace= Microsoft.CodeAnalysis.CSharp
dotnet_diagnostic.CS8019.severity = Suggestion # Unnecessary using directive

# C# files in test projects (broader than the *Tests.cs glob below - also covers fixtures,
# builders, and other test-support files)
[tests/**/*.cs]
# AnalyzerId= NSubstitute.Analyzers.CSharp  RuleNamespace= NSubstitute.Analyzers
# Flags invalid Substitute.For<T> usage (non-virtual members, argument matchers used outside a
# call, misuse of Returns/ThrowsAsync, internal-member substitution without InternalsVisibleTo,
# etc.). Referenced by every tests/*.csproj; runs on its shipped default severities - nothing here
# currently warrants a stronger or weaker severity than NSubstitute.Analyzers.CSharp's own defaults.

# AnalyzerId= xunit.analyzers  RuleNamespace= xunit.analyzers
# Flags xUnit usage mistakes (xUnit-prefixed): misused [Fact]/[Theory] attributes, missing
# [InlineData] parameters, comparer/assertion misuse, test classes with no runnable tests, etc.
# Comes in transitively with the xunit.v3 package reference (not a direct PackageReference of its
# own); runs on its shipped default severities, with one exception: xUnit1051 ("use
# TestContext.Current.CancellationToken") stays at its shipped default (Warning) - every call this
# flags gets that token threaded through, not suppressed, since xunit.v3 test cancellation actually
# depends on it.

# AnalyzerId= Microsoft.VisualStudio.Threading.Analyzers  RuleNamespace= Microsoft.VisualStudio.Threading.Analyzers
# VSTHRD111 ("use ConfigureAwait(bool)") directly contradicts xUnit1030 ("test methods should not
# call ConfigureAwait(false), as it may bypass parallelization limits") for every await inside a
# [Fact]/[Theory] body - xUnit1030 wins here because xunit.v3 test methods never run under a
# SynchronizationContext in the first place, so ConfigureAwait(false) buys nothing but the
# parallelization risk xUnit1030 warns about. Left at full severity in src/, where the
# SynchronizationContext a consumer's own await runs under is genuinely unknown.
dotnet_diagnostic.VSTHRD111.severity = None # Use ConfigureAwait(bool) on the awaited expression

# AnalyzerId= IDisposableAnalyzers  RuleNamespace= IDisposableAnalyzers
# IDISP001 ("Dispose created") fires on almost every DI container/scope a test builds inline
# (services.BuildServiceProvider(), builder.Build() for an Autofac IContainer, etc.) and then uses
# for the rest of a short-lived test method without an explicit using - idiomatic in this test
# suite's fixtures, not a leak (the container is GC'd with the test). IDISP004 ("Don't ignore
# created IDisposable") fires on the same idiom when the container is chained straight into a
# resolve call instead of assigned to a variable first (services.BuildServiceProvider().GetRequiredService<T>()) -
# same non-leak, same rationale. Both left at full severity in src/, where the same pattern would matter.
dotnet_diagnostic.IDISP001.severity = Suggestion # Dispose created
dotnet_diagnostic.IDISP004.severity = Suggestion # Don't ignore created IDisposable

# IDISP011 ("Don't return disposed instance") fires on every `new Lazy<ISession>(() => session)` /
# `new Lazy<TContext>(() => context)` this test suite builds to hand a real, `using`-scoped
# session/context to a unit-of-work or repository under test, matching production's own
# Lazy<T>-injection idiom - IDisposableAnalyzers sees the lambda capturing a `using` variable and
# assumes it can be invoked after disposal. In every case here the Lazy is realized well within the
# same test method, before the `using` block disposes anything - left at full severity in src/.
dotnet_diagnostic.IDISP011.severity = Suggestion # Don't return disposed instance

# C# Tests files in Tests projects
[{**Tests/**Tests.cs,**Tests.**/**Tests.cs}]
# Reset StyleCop documentation comments
dotnet_diagnostic.SA1600.severity = Suggestion	# A C# code element is missing a documentation header.
dotnet_diagnostic.SA1601.severity = Suggestion	# A C# partial element is missing a documentation header.
dotnet_diagnostic.SA1602.severity = Suggestion	# An item within a C# enumeration is missing an Xml documentation header.

# Test fixture files routinely declare several supporting types (records, marker interfaces,
# handler stubs) ahead of the XxxTests class that uses them - relax the multi-type/file-name-match
# rules here; both stay fully enforced in src/.
dotnet_diagnostic.SA1402.severity = Suggestion	# File may only contain a single type.
dotnet_diagnostic.SA1649.severity = Suggestion	# File name must match first type name.

# Sonar
dotnet_diagnostic.S4114.severity = Suggestion   # Methods should not have identical implementations

# Misc
dotnet_diagnostic.CS1591.severity = Suggestion # Missing XML comment for publicly visible type or member 'Type_or_Member'
dotnet_diagnostic.CA1707.severity = None       # Identifiers should not contain underscores
dotnet_diagnostic.RCS1192.severity = Warning   # RCS1192: Unnecessary usage of verbatim string literal.

# TutorialProject's TodoTasks feature: S1135's "TODO" comment scanner matches the token on a
# non-word-character boundary, not just whole-word "TODO". Every hit in this pair of trees is a
# false positive from that boundary rule tripping on this feature's own vocabulary - the route
# segment "/todo-tasks" and the doc filename "beginners-guide-todo-api.md", both hyphen/slash-
# delimited so "todo" reads as its own bounded token - not an actual "// TODO" marker; a solution-
# wide grep for "// TODO" confirms zero real ones exist anywhere. This repo tracks follow-up work
# as tickets under .scratch/<feature>/issues/ (see CLAUDE.md), not inline TODO comments, so a
# genuine one is unlikely to land here uncaught; scoped to these two trees rather than solution-
# wide so S1135 stays live for the rest of src/ and tests/.
[{TutorialProject/TodoTasks.Api/**/*.cs,TutorialProject/TodoTasks.Api/*.cs,tests/TodoTasks.Api.Tests/**/*.cs,tests/TodoTasks.Api.Tests/*.cs}]
dotnet_diagnostic.S1135.severity = None # Complete the task associated to this "TODO" comment.
