# The Roslyn C# compiler itself, not an installed analyzer package - CS-prefixed diagnostics.
dotnet_diagnostic.CS8019.severity = Warning # Unnecessary using directive

# AnalyzerId= Microsoft.CodeAnalysis.CSharp.Analyzers  RuleNamespace= Microsoft.CodeAnalysis.CSharp.Analyzers
# Analyzer-authoring analyzers (RS-prefixed) from the Microsoft.CodeAnalysis.Analyzers package,
# referenced by Interlocutor.Generator to keep the source generator itself well-behaved.
dotnet_diagnostic.RS1022.severity = Warning # Do not use types from the Workspaces assembly in an analyzer

# AnalyzerId= Microsoft.CodeAnalysis.CSharp.CodeStyle  RuleNamespace= Microsoft.CodeAnalysis.CSharp.CodeStyle
