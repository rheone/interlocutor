    <ProjectReference Include="..\..\src\Interlocutor.DependencyInjection.Microsoft\Interlocutor.DependencyInjection.Microsoft.csproj" />
    <!-- Deliberately isolated from Interlocutor.DependencyInjection.Microsoft.Tests: AddTransactionBehavior()
         prefers EF Core over NHibernate whenever EF Core is referenced in the same assembly, so this
         project exists solely to prove the Microsoft-DI-specific EF Core arity failure (and its documented
         workaround) without disturbing that project's own NHibernate-arity-2 assumptions - see
         PipelineOrderingIntegrationTests there and TransactionBehaviorArityTests here. -->
