<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\Interlocutor.DependencyInjection.Microsoft\Interlocutor.DependencyInjection.Microsoft.csproj" />
    <!-- Referenced so a real ValidationBehavior resolution can be proven through a built ServiceProvider,
         not only a registration-list check - see BehaviorSubsetConstraintTests. -->
    <ProjectReference Include="..\..\src\Interlocutor.FluentValidation\Interlocutor.FluentValidation.csproj" />
    <!-- Referenced so UseRecommendedChain() wires the real NHibernate TransactionBehavior<,> (arity 2) instead
         of no-op'ing - see PipelineOrderingIntegrationTests, which needs every stage in the canonical chain
         to be the real, shipped implementation, not a stand-in. -->
    <ProjectReference Include="..\..\src\Interlocutor.NHibernate\Interlocutor.NHibernate.csproj" />
    <!-- Referenced so AddInterlocutorUnitOfWork/AddInterlocutorRepository can be proven to resolve a real
         EF Core implementation sharing one scoped DbContext - see PersistenceRegistrationTests. -->
    <ProjectReference Include="..\..\src\Interlocutor.Persistence.EntityFrameworkCore\Interlocutor.Persistence.EntityFrameworkCore.csproj" />
    <!-- Analyzer-only reference: runs Interlocutor.Generator over this project's own compilation so
         GeneratedRegistrationIntegrationTests can dispatch through the real, compile-time discovered
         Interlocutor.Generated.InterlocutorGeneratedRegistrations module instead of runtime scanning. -->
    <ProjectReference
      Include="..\..\src\Interlocutor.Generator\Interlocutor.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>
</Project>
