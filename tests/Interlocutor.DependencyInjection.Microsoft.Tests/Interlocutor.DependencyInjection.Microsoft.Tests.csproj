<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\Interlocutor.DependencyInjection.Microsoft\Interlocutor.DependencyInjection.Microsoft.csproj" />
    <!-- Referenced so a real ValidationBehavior resolution can be proven through a built ServiceProvider,
         not only a registration-list check - see BehaviorSubsetConstraintTests. -->
    <ProjectReference Include="..\..\src\Interlocutor.FluentValidation\Interlocutor.FluentValidation.csproj" />
    <!-- Referenced so UseRecommendedChain() wires the real NHibernate UnitOfWorkBehavior<,> (arity 2) instead
         of no-op'ing - see PipelineOrderingIntegrationTests, which needs every stage in the canonical chain
         to be the real, shipped implementation, not a stand-in. -->
    <ProjectReference Include="..\..\src\Interlocutor.Persistence.NHibernate\Interlocutor.Persistence.NHibernate.csproj" />
    <!-- Deliberately does NOT reference Interlocutor.Persistence.EntityFrameworkCore: that assembly now also
         hosts the EF Core UnitOfWorkBehavior<,,> (arity 3), and Type.GetType's process-wide assembly search
         would make AddUnitOfWorkBehavior()'s EF-preferred `??` probe find it the moment the assembly is
         loaded into this test process - even from a test that never calls AddUnitOfWorkBehavior() itself -
         breaking every UseRecommendedChain()/PipelineOrderingIntegrationTests assertion in this project that
         expects the real NHibernate arity-2 UnitOfWorkBehavior<,>. AddInterlocutorUnitOfWork/AddInterlocutorRepository
         EF Core coverage lives in Interlocutor.DependencyInjection.Microsoft.EntityFrameworkCore.Tests instead,
         which is already isolated for the same reason - see PersistenceRegistrationTests there. -->
    <!-- Analyzer-only reference: runs Interlocutor.Generator over this project's own compilation so
         GeneratedRegistrationIntegrationTests can dispatch through the real, compile-time discovered
         Interlocutor.Generated.InterlocutorGeneratedRegistrations module instead of runtime scanning. -->
    <ProjectReference
      Include="..\..\src\Interlocutor.Generator\Interlocutor.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp" />
  </ItemGroup>
</Project>
