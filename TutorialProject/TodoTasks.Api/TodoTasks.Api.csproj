<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>
      Proof-of-concept ASP.NET Core minimal API that fully implements documentation/beginners-guide-todo-api.md
      end to end - NHibernate, FluentValidation, and Autofac, exactly as the guide uses. Vertical slices
      by directory under Features/. Never published, never released - see .scratch/tutorial-project/PRD.md.
    </Description>
    <!-- Overrides Directory.Build.props' repo-wide default: this project is never packaged or shipped. -->
    <IsPackable>false</IsPackable>
    <RootNamespace>TodoTasks.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Interlocutor.Abstractions\Interlocutor.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Interlocutor.AspNetCore\Interlocutor.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Interlocutor.DependencyInjection.Autofac\Interlocutor.DependencyInjection.Autofac.csproj" />
    <ProjectReference Include="..\..\src\Interlocutor.FluentValidation\Interlocutor.FluentValidation.csproj" />
    <ProjectReference Include="..\..\src\Interlocutor.Persistence.NHibernate\Interlocutor.Persistence.NHibernate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac.Extensions.DependencyInjection" />
    <PackageReference Include="FluentNHibernate" />
    <PackageReference Include="NHibernate" />
    <PackageReference Include="System.Data.SQLite.Core" />
  </ItemGroup>
</Project>
