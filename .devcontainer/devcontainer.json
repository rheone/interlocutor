{
  "name": "Interlocutor Dev Container",
  "image": "mcr.microsoft.com/devcontainers/dotnet:2-11.0-preview",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainer-community/devcontainer-features/delta:1": {},
    "ghcr.io/devcontainer-community/devcontainer-features/lazygit:1": {},
    "ghcr.io/devcontainers-community/npm-features/prettier:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/dotnet:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:2": {},
    "ghcr.io/devcontainers/features/powershell:2": {},
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/jsburckhardt/devcontainer-features/zoxide:1": {},
    "ghcr.io/nikiforovall/devcontainer-features/dotnet-csharpier:1": {},
    "ghcr.io/nils-geistmann/devcontainers-features/zsh:0": {},
    "ghcr.io/rosstaco/devcontainer-features/ohmyposh:1": {}
  },
  "containerEnv": {
    "CLAUDE_RUNTIME_DIR": "/home/vscode/.claude-runtime",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "ENABLE_LSP_TOOL": "1",
    "GIT_CONFIG_GLOBAL": "/home/vscode/.config/git/config",
    "NUGET_XMLDOC_MODE": "skip"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "csharpier.csharpier-vscode",
        "editorconfig.editorconfig",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions",
        "gruntfuggly.todo-tree",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.powershell",
        "oderwat.indent-rainbow",
        "streetsidesoftware.code-spell-checker",
        "tyriar.sort-lines",
        "yzhang.markdown-all-in-one",
        "github.vscode-codeql",
        "github.vscode-pull-request-github",
        "jojoco.markdownfromcsv",
        "shd101wyy.markdown-preview-enhanced",
        "fedaykindev.openchamber",
        "sst-dev.opencode",
        "anthropic.claude-code"
      ],
      "settings": {
        "diffEditor.ignoreTrimWhitespace": false,
        "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true,
        "editor.guides.bracketPairs": true,
        "editor.inlineSuggest.enabled": true,
        "editor.formatOnSave": true,
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "files.autoGuessEncoding": false,
        "files.encoding": "utf8",
        "files.eol": "\n",
        "git.autofetch": true,
        "terminal.integrated.defaultProfile.linux": "pwsh"
      },
      "remoteUser": "vscode",
      "updateRemoteUserUID": true,
      "mounts": [
        "source=${localEnv:USERPROFILE}\\.claude,target=/mnt/windows-user/.claude,type=bind,readonly",
        "source=${localEnv:USERPROFILE}\\.agents,target=/mnt/windows-user/.agents,type=bind,readonly"
      ]
    }
  }
}
