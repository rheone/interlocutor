<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Roslynator -->
  <ItemGroup>
    <PackageVersion Include="Roslynator.Analyzers" Version="4.16.0" />
    <PackageVersion Include="Roslynator.CodeAnalysis.Analyzers" Version="4.16.0" />
    <PackageVersion Include="Roslynator.CodeFixes" Version="4.15.0" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="4.16.0" />
    <PackageVersion Include="Roslynator.Refactorings" Version="4.15.0" />
  </ItemGroup>
  <!-- StyleCop -->
  <ItemGroup>
    <!-- 1.2.0-beta is required for record support: 1.1.x SA1313 flags PascalCase positional-record
         parameters, which are correct (they become public properties). -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>
  <!-- Microsoft extensions (ship with .NET 11) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0-preview.6.26359.118" />
  </ItemGroup>
  <!-- Entity Framework Core -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0-preview.6.26359.118" />
  </ItemGroup>
  <!-- FluentValidation -->
  <ItemGroup>
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>
  <!-- NHibernate -->
  <ItemGroup>
    <PackageVersion Include="NHibernate" Version="5.7.0" />
  </ItemGroup>
  <!-- Autofac -->
  <ItemGroup>
    <PackageVersion Include="Autofac" Version="9.3.2" />
    <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
  </ItemGroup>
  <!-- xUnit v3 + MTP test packages -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.3.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>
  <!-- NSubstitute -->
  <ItemGroup>
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
  </ItemGroup>
  <!-- Architecture tests -->
  <ItemGroup>
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
  <!-- Source Link -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
  </ItemGroup>
</Project>
