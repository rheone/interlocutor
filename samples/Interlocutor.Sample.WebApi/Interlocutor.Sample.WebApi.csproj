<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>Runnable sample application for Interlocutor (tickets 18, 17). Shows the intended composition end to end: an explicitly composed pipeline, cross-assembly handler discovery, a short-circuiting stage, a multi-subscriber notification, and transport conversion at the edge - and publishes ahead-of-time compiled with no trim/AOT warnings (see documentation/trim-and-aot-support.md).</Description>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Ticket 17: proves the library's trim guarantee against a real application rather than just the
         library's own analyzer-clean build.

         Deliberately PublishTrimmed, NOT PublishAot. PublishAot was tried and reverted: it produces a binary
         that builds warning-free and then throws on every single dispatch, because the container cannot close
         IPipelineBehavior<TRequest,TResponse> over a value-type OperationOutcome<...> without a JIT. Setting it
         here would re-assert a guarantee the library does not currently hold. See
         documentation/trim-and-aot-support.md and maintainer_docs/research/native-aot-and-trimming-options.md. -->
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Interlocutor.AspNetCore\Interlocutor.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Interlocutor.DependencyInjection.Microsoft\Interlocutor.DependencyInjection.Microsoft.csproj" />
    <ProjectReference Include="..\..\src\Interlocutor.Persistence.EntityFrameworkCore\Interlocutor.Persistence.EntityFrameworkCore.csproj" />

    <!-- Normal reference: brings in the handler assembly's types plus the InterlocutorGeneratedModuleAttribute
         that lets this project's own generator run aggregate the handler assembly's generated module too
         (ticket 12) - the mechanism behind "cross-assembly discovery with no assembly list". -->
    <ProjectReference Include="..\Interlocutor.Sample.Handlers\Interlocutor.Sample.Handlers.csproj" />

    <!-- Analyzer-only reference: runs Interlocutor.Generator over this assembly's own compilation.
         UndefineProperties stops publish-time properties (PublishTrimmed, RuntimeIdentifier, ...) from
         propagating into this netstandard2.0 project, which cannot build with them set - ReferenceOutputAssembly
         excludes it from the publish *output*, not from inheriting the publish-time global property set. -->
    <ProjectReference
      Include="..\..\src\Interlocutor.Generator\Interlocutor.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      UndefineProperties="PublishTrimmed;PublishAot;PublishReadyToRun;PublishSingleFile;RuntimeIdentifier;SelfContained"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Design-time only: regenerates CompiledModels/ via `dotnet ef dbcontext optimize` when SampleDbContext's
         model changes. PrivateAssets="all" keeps it out of the published output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
